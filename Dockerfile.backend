# webrace backend container: runs the map-server (pk3 -> bsp/texture serving,
# padpork fallback) and the leaderboard server (SQLite). Static client files
# are served by Caddy directly; this container only handles the API paths.
#
# Node 22 (built-in fetch + node:sqlite). No Rust needed at runtime — the WASM
# core and client are built on the dev machine and served as static assets.

FROM node:22-alpine

WORKDIR /app

COPY server/ ./server/
# Optional drop-in sounds for the dev Sound menu (empty dir is fine).
COPY snd/ ./snd/

ENV MAP_PORT=4173 \
    LB_PORT=4174 \
    DATA_DIR=/app/data \
    PK3_CACHE_DIR=/app/data/pk3-cache \
    DB_PATH=/app/data/leaderboard.db

# Persist cached pk3s + the sqlite db.
VOLUME /app/data

EXPOSE 4173 4174

CMD ["sh", "-c", "node server/map-server.mjs & node server/leaderboard.mjs & wait -n"]
